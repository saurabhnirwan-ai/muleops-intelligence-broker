# PagerDuty Specialist Agent — Environment Variables
# Copy to .env and fill in real values

PAGERDUTY_API_TOKEN=<YOUR_PAGERDUTY_READ_ONLY_API_TOKEN>
PAGERDUTY_SERVICE_ID=<YOUR_PAGERDUTY_SERVICE_ID>
PAGERDUTY_ESCALATION_POLICY_ID=<YOUR_ESCALATION_POLICY_ID>
PAGERDUTY_FROM_EMAIL=<YOUR_EMAIL>

# Gemini API key (primary). Get from https://aistudio.google.com/
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Optional: second Gemini key for automatic quota-exceeded fallback.
# When the primary key hits a 429/quota error, the agent retries with this key.
GEMINI_API_KEY_FALLBACK=<YOUR_GEMINI_API_KEY_FALLBACK>

PORT=8080