SF_CLIENT_ID=<YOUR_SALESFORCE_CONNECTED_APP_CLIENT_ID>
SF_CLIENT_SECRET=<YOUR_SALESFORCE_CONNECTED_APP_CLIENT_SECRET>
SF_INSTANCE_URL=https://<YOUR_ORG>.my.salesforce.com
SF_AGENT_ID=<YOUR_AGENTFORCE_AGENT_ID>
SF_AGENT_API_BASE_URL=https://api.salesforce.com

# JWT Bearer Flow (preferred — required for JWT-format access tokens)
# Generate an RSA key pair, upload the public cert to the Salesforce Connected App,
# and provide the path to the private key file below.
# SF_RUN_AS_USER must be pre-authorized in the Connected App's "Manage Profiles" section.
SF_PRIVATE_KEY_PATH=/opt/integration-agent/sf_private.key
SF_RUN_AS_USER=<YOUR_SALESFORCE_USERNAME_OR_EMAIL>

PORT=8082
